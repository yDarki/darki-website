# Always revalidate shared CSS/JS so an updated page never loads stale styles.
/theme.css
  Cache-Control: public, max-age=0, must-revalidate

/gate.js
  Cache-Control: public, max-age=0, must-revalidate

# Ausgelagerte Seiten-Skripte: immer revalidieren, damit ein Deploy sofort greift.
/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Ausgelagerte Seiten-Styles: immer revalidieren.
/css/*
  Cache-Control: public, max-age=0, must-revalidate
